// ==========================================
// 10. FAQ จากชีต (คอลัมน์ A คำหลัก, B คำค้นเพิ่มเติมคั่นด้วย , , D คำตอบ)
// ==========================================
function handleFAQ(userText, ss, replyToken) {
  const sh = ss.getSheetByName(SHEET_FAQ);
  if (!sh) return false;
  const rows = sh.getDataRange().getValues();
  const clean = norm_(userText);
  if (!clean) return false;
  for (let i = 1; i < rows.length; i++) {
    const answer = rows[i][3] ? String(rows[i][3]).replace(/\\n/g, '\n') : '';
    if (!answer) continue;
    const kws = [rows[i][0]].concat(String(rows[i][1] || '').split(','));
    for (let j = 0; j < kws.length; j++) {
      const k = norm_(String(kws[j] || ''));
      if (k && clean.indexOf(k) !== -1) { sendCustomFlexPopup(replyToken, '💡 คำแนะนำสุขภาพเด็ก', answer, C.primary); return true; }
    }
  }
  return false;
}

// ==========================================
// 11. สกัดข้อมูลจากข้อความ
// ==========================================
function extractParentName(text) {
  if (text.indexOf('อาการ') !== -1) return '-';
  const m = text.match(/(แม่|พ่อ|ผู้ปกครอง|นางสาว|นาง|นาย|ยาย|ย่า|ป้า|น้า)\s*([ก-๙a-zA-Z]+(\s+[ก-๙a-zA-Z]+)?)/i);
  if (!m) return '-';
  return (m[1] + m[2]).trim().replace(/(โทร|นัด|วัคซีน|สถานที่|รับที่|รับวัคซีนที่).*$/i, '').trim();
}

function extractRelation(text) {
  if (text.indexOf('อาการ') !== -1) return 'ผู้ปกครอง';
  if (/แม่|มารดา|นางสาว|นาง/.test(text)) return 'มารดา';
  if (/พ่อ|บิดา|นาย/.test(text)) return 'บิดา';
  if (text.indexOf('ยาย') !== -1) return 'ยาย';
  if (text.indexOf('ย่า') !== -1) return 'ย่า';
  if (text.indexOf('ป้า') !== -1) return 'ป้า';
  if (text.indexOf('น้า') !== -1) return 'น้า';
  return 'ผู้ปกครอง';
}

function extractPhoneNumber(text) {
  const m = text.match(/(0\d{8,9}|0\d{1,2}[\-\s]\d{3,4}[\-\s]\d{3,4})/);
  return m ? m[0].replace(/[\-\s]/g, '') : '-';
}

function extractLocation(text) {
  const m = text.match(/(รพ\.สต\.[ก-๙a-zA-Z0-9\s]+|รพสต\s*[ก-๙a-zA-Z0-9\s]+|รพ\.[ก-๙a-zA-Z0-9\s]+|โรงพยาบาล[ก-๙a-zA-Z0-9\s]+|ศูนย์แพทย์[ก-๙a-zA-Z0-9\s]+|ศสช\.?[ก-๙a-zA-Z0-9\s]+)/i);
  if (m) return m[0].trim();
  const m2 = text.match(/(รับที่|สถานที่)\s*([ก-๙a-zA-Z0-9\.\s]+)/i);
  return m2 ? m2[2].split(' ')[0].trim() : '-';
}

function extractChildName(text) {
  const t = text.replace(/\s+/g, ' ').trim();
  const m = t.match(/(เด็กหญิง|เด็กชาย|ด\.ญ\.|ด\.ช\.|ดญ\.|ดช\.|ดญ|ดช|น้อง)\s*([ก-๙a-zA-Z]+(\s+[ก-๙a-zA-Z]+)?)/i);
  if (!m) return 'หนูน้อย';
  return (m[1] + ' ' + m[2]).trim().replace(/(นัด|วัคซีน|วันที่|วันนัด|ฉีด|แม่|พ่อ|โทร|รับที่).*$/i, '').trim();
}

function toGregorianYear_(y) {
  if (y < 100) y += 2500;          // 69 -> 2569 (ผู้ใช้ส่วนใหญ่พิมพ์ พ.ศ. 2 หลัก)
  if (y > 2400) y -= 543;          // พ.ศ. -> ค.ศ.
  return y;
}

function extractDateFromText(text) {
  if (!text) return null;
  const num = text.match(/(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{2,4})/);
  if (num) {
    const d = new Date(toGregorianYear_(parseInt(num[3], 10)), parseInt(num[2], 10) - 1, parseInt(num[1], 10));
    return isNaN(d.getTime()) ? null : d;
  }
  const months = [
    ['ม.ค.', 'มกรา', 'มค'], ['ก.พ.', 'กุมภา', 'กพ'], ['มี.ค.', 'มีนา', 'มีค'], ['เม.ย.', 'เมษา', 'เมย'],
    ['พ.ค.', 'พฤษภา', 'พค'], ['มิ.ย.', 'มิถุนา', 'มิย'], ['ก.ค.', 'กรกฎา', 'กค'], ['ส.ค.', 'สิงหา', 'สค'],
    ['ก.ย.', 'กันยา', 'กย'], ['ต.ค.', 'ตุลา', 'ตค'], ['พ.ย.', 'พฤศจิกา', 'พย'], ['ธ.ค.', 'ธันวา', 'ธค']
  ];
  // ตัดวลีอายุวัคซีนออกก่อน เช่น "วัคซีน 9 เดือน", "1 ปี 6 เดือน"
  const cleaned = text.replace(/\d+\s*ปี\s*\d+\s*เดือน/g, ' ').replace(/\d+\s*เดือน/g, ' ').replace(/\d+\s*ปี/g, ' ');
  const re = /(\d{1,2})\s*([ก-๙\.]+)\s*(\d{2,4})?/g;
  let m;
  while ((m = re.exec(cleaned)) !== null) {
    const day = parseInt(m[1], 10);
    const ms = m[2].trim();
    let mi = -1;
    for (let i = 0; i < months.length && mi === -1; i++) {
      if (months[i].some(function (n) { return ms.indexOf(n) === 0; })) mi = i;
    }
    if (mi !== -1 && day >= 1 && day <= 31) {
      let y = m[3] ? toGregorianYear_(parseInt(m[3], 10)) : new Date().getFullYear();
      let d = new Date(y, mi, day);
      // ไม่ระบุปีและวันที่ผ่านไปนานแล้ว ให้ถือเป็นปีถัดไป
      if (!m[3] && d.getTime() < Date.now() - 30 * 86400000) d = new Date(y + 1, mi, day);
      return d;
    }
  }
  return null;
}

// อ่านช่วงวัยของนัดจากข้อความ (แก้ปัญหา "12 เดือน" ถูกอ่านเป็น "2 เดือน")
function matchVaccineName(text) {
  const t = norm_(text);
  const age = function (re) { return re.test(t); };
  if (age(/แรกเกิด|bcg/)) return 'วัคซีนแรกเกิด (BCG, HB1)';
  if (age(/1ปี6เดือน|1ขวบ6เดือน|ขวบครึ่ง|ปีครึ่ง|(^|[^0-9])18เดือน/)) return 'วัคซีน 1 ปี 6 เดือน (DTP4, OPV4, MMR2)';
  if (age(/2ปี6เดือน|2ขวบ6เดือน|2ขวบครึ่ง|2ปีครึ่ง|(^|[^0-9])30เดือน/)) return 'วัคซีน 2 ปี 6 เดือน (LAJE2)';
  if (age(/(^|[^0-9])12เดือน|(^|[^0-9])1ปี|(^|[^0-9])1ขวบ|เจอี1|laje1/)) return 'วัคซีน 1 ปี (LAJE1, PCV เข็มกระตุ้น)';
  if (age(/(^|[^0-9])4ปี|(^|[^0-9])4ขวบ|อนุบาล/)) return 'วัคซีน 4 ปี (DTP5, OPV5)';
  if (age(/(^|[^0-9])9เดือน|หัด1|mmr1/)) return 'วัคซีน 9 เดือน (MMR1)';
  if (age(/(^|[^0-9])6เดือน/)) return 'วัคซีน 6 เดือน (DTP-HB-Hib3, OPV3, Rota3)';
  if (age(/(^|[^0-9])4เดือน|โรต้า2/)) return 'วัคซีน 4 เดือน (DTP-HB-Hib2, IPV2, Rota2, PCV2)';
  if (age(/(^|[^0-9])2เดือน|โรต้า1/)) return 'วัคซีน 2 เดือน (DTP-HB-Hib1, IPV1, Rota1, PCV1)';
  if (age(/(^|[^0-9])1เดือน/)) return 'วัคซีน 1 เดือน (HB2 กรณีแม่เป็นพาหะ)';
  if (age(/pcv/)) return 'วัคซีน PCV';
  if (age(/mmr/)) return 'วัคซีนหัด-คางทูม-หัดเยอรมัน (MMR)';
  if (age(/hpv|ป\.5/)) return 'วัคซีน HPV';
  if (age(/ไข้หวัดใหญ่|flu/)) return 'วัคซีนไข้หวัดใหญ่';
  return 'วัคซีนตามเกณฑ์';
}

// ==========================================
// 12. บันทึกและอ่านข้อมูลนัดหมาย (โครงสร้างคอลัมน์เดิม)
//   A เวลา | B LINE UID | C ผู้ปกครอง | D โทร | E ความสัมพันธ์ | F ชื่อเด็ก | H สถานที่ | J วัคซีน | K วันนัด | L สถานะ
// ==========================================
function findUserRow_(sheet, userId) {
  const ids = sheet.getRange(1, 2, Math.max(sheet.getLastRow(), 1), 1).getValues();
  for (let i = ids.length - 1; i >= 1; i--) if (ids[i][0] === userId) return i + 1; // แถวล่าสุดของผู้ใช้
  return -1;
}

function readRowResult_(sh, r) {
  const v = sh.getRange(r, 1, 1, 12).getValues()[0];
  const parent = v[2] || '-', phone = v[3] || '-', loc = v[7] || '-';
  return {
    success: true,
    isMissingParentInfo: (parent === '-' || phone === '-' || loc === '-'),
    childName: v[5] || 'หนูน้อย', parentName: parent, relation: v[4] || 'ผู้ปกครอง', phone: phone, location: loc,
    vaccine: v[9] || 'วัคซีนตามเกณฑ์',
    dateStr: (v[10] instanceof Date) ? Utilities.formatDate(v[10], TZ, 'dd/MM/yyyy') : '-'
  };
}

function updateParentInfoOnly(userId, userText, ss) {
  const sh = ss.getSheetByName(SHEET_MAIN);
  if (!sh) return { success: false };
  const r = findUserRow_(sh, userId);
  if (r === -1) return { success: false };
  const p = extractParentName(userText), ph = extractPhoneNumber(userText), rel = extractRelation(userText), loc = extractLocation(userText);
  if (p !== '-') sh.getRange(r, 3).setValue(p);
  if (ph !== '-') sh.getRange(r, 4).setValue(ph);
  if (rel !== 'ผู้ปกครอง') sh.getRange(r, 5).setValue(rel);
  if (loc !== '-') sh.getRange(r, 8).setValue(loc);
  return readRowResult_(sh, r);
}

function saveUserAppointmentInput(userId, userText, extractedDate, ss) {
  const sh = ss.getSheetByName(SHEET_MAIN);
  if (!sh) return { success: false };
  const vac = matchVaccineName(userText), child = extractChildName(userText), p = extractParentName(userText),
    rel = extractRelation(userText), ph = extractPhoneNumber(userText), loc = extractLocation(userText);
  let r = findUserRow_(sh, userId);
  if (r !== -1) {
    if (p !== '-') sh.getRange(r, 3).setValue(p);
    if (ph !== '-') sh.getRange(r, 4).setValue(ph);
    if (rel !== 'ผู้ปกครอง') sh.getRange(r, 5).setValue(rel);
    if (child !== 'หนูน้อย') sh.getRange(r, 6).setValue(child);
    if (loc !== '-') sh.getRange(r, 8).setValue(loc);
    sh.getRange(r, 10, 1, 3).setValues([[vac, extractedDate, STATUS_WAIT]]);
  } else {
    sh.appendRow([new Date(), userId, p, ph, rel, child, '', loc, '', vac, extractedDate, STATUS_WAIT]);
    r = sh.getLastRow();
  }
  return readRowResult_(sh, r);
}

