// 15. เช็กนัด และบันทึกว่ามาตามนัด
// ==========================================
function handleCheckAppointment(userId, ss, replyToken) {
  const sh = ss.getSheetByName(SHEET_MAIN);
  if (!sh) return sendCustomFlexPopup(replyToken, '❌ เกิดข้อผิดพลาด', 'ไม่พบฐานข้อมูลนัดหมายในระบบ', C.bad);
  const data = sh.getDataRange().getValues();
  const items = [];
  for (let i = 1; i < data.length && items.length < 8; i++) {
    if (data[i][1] !== userId) continue;
    const d = data[i][10];
    const done = data[i][11] === STATUS_DONE;
    items.push({
      type: 'box', layout: 'vertical', margin: 'md', backgroundColor: done ? '#EEF8EE' : C.bg, cornerRadius: '12px', paddingAll: '12px', spacing: 'xs',
      contents: [
        txt_('👶 ' + (data[i][5] || 'หนูน้อย'), { weight: 'bold', color: C.deep }),
        txt_('💉 ' + (data[i][9] || 'วัคซีนตามเกณฑ์'), { size: 'xs' }),
        txt_('🏥 ' + (data[i][7] || 'สถานบริการใกล้บ้าน'), { size: 'xs' }),
        txt_('📅 ' + ((d instanceof Date) ? Utilities.formatDate(d, TZ, 'dd/MM/yyyy') : (d || '-')), { size: 'sm', weight: 'bold', color: C.primary }),
        txt_((done ? '✅ ' : '⏳ ') + (data[i][11] || STATUS_WAIT), { size: 'xs', color: done ? C.ok : C.muted })
      ]
    });
  }
  if (!items.length) return sendCustomFlexPopup(replyToken, 'ยังไม่พบนัดหมาย', 'พิมพ์ "ลงทะเบียน" แล้วส่งข้อมูลนัดของน้องเข้ามาได้เลยค่ะ', C.warn);
  const b = bubble_(header_('FollowUp EPI Ubon', 'นัดหมายรับวัคซีนของน้อง', C.primary), items.concat([
    txt_('📌 นำสมุดบันทึกสุขภาพแม่และเด็ก (สมุดสีชมพู) มาทุกครั้ง', { size: 'xs', color: C.warn, margin: 'lg' })
  ]));
  reply_(replyToken, [flexMsg_('ตารางนัดหมายรับวัคซีน', b)]);
}

function handleArrivalStatus(userId, ss, replyToken) {
  const today = Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd');
  let updated = false, child = 'หนูน้อย';
  const sh = ss.getSheetByName(SHEET_MAIN);
  if (sh) {
    const data = sh.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (data[i][1] !== userId) continue;
      child = data[i][5] || child;
      const d = (data[i][10] instanceof Date) ? Utilities.formatDate(data[i][10], TZ, 'yyyy-MM-dd') : '';
      if (d === today && data[i][11] !== STATUS_DONE) { sh.getRange(i + 1, 12).setValue(STATUS_DONE); updated = true; }
    }
  }
  const f = ss.getSheetByName(SHEET_FOLLOW);
  if (f) {
    const fd = f.getDataRange().getValues();
    for (let j = 1; j < fd.length; j++) if (fd[j][0] === userId && fd[j][4] !== STATUS_DONE) { f.getRange(j + 1, 5).setValue(STATUS_DONE); updated = true; }
  }
  sendCustomFlexPopup(replyToken, '✅ บันทึกว่ามารับวัคซีนแล้ว',
    (updated ? 'บันทึกข้อมูลของ' + child + 'เรียบร้อยแล้วค่ะ' : 'บันทึกสถานะเรียบร้อยแล้วค่ะ') +
    '\n\nหลังฉีดอาจมีไข้หรือบวมแดงเล็กน้อย 1–2 วัน ถ้ามีอาการผิดปกติ พิมพ์อาการเข้ามาได้เลย เช่น "น้องมีไข้"', C.ok);
}

// ==========================================
// 16. แจ้งเตือนอัตโนมัติ (ตั้งด้วย setupTriggers)
// ==========================================
function eachAppointment_(offsetDays, fn) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_MAIN);
  if (!sh) return;
  const target = new Date(); target.setDate(target.getDate() + offsetDays);
  const key = Utilities.formatDate(target, TZ, 'yyyy-MM-dd');
  sh.getDataRange().getValues().forEach(function (row, i) {
    if (i === 0 || !(row[10] instanceof Date) || !row[1]) return;
    if (Utilities.formatDate(row[10], TZ, 'yyyy-MM-dd') !== key) return;
    try { fn(row); } catch (err) { console.error('reminder row ' + (i + 1) + ': ' + err); }
  });
}
const notDone_ = function (row) { return row[11] !== STATUS_DONE; };
const dstr_ = function (d) { return Utilities.formatDate(d, TZ, 'dd/MM/yyyy'); };

function sendReminder_3DaysBefore() {
  eachAppointment_(3, function (r) {
    if (notDone_(r)) pushFlexCard(r[1], '🔔 อีก 3 วันมีนัดรับวัคซีน', 'วันที่ ' + dstr_(r[10]) + ' น้อง ' + r[5] + ' มีนัด ' + r[9] + ' ที่ ' + r[7] + '\n\nเตรียมสมุดสีชมพูไว้ด้วยนะคะ', C.warn);
  });
}
function sendReminder_1DayBefore() {
  eachAppointment_(1, function (r) {
    if (notDone_(r)) pushFlexCard(r[1], '🔔 พรุ่งนี้มีนัดรับวัคซีน', 'น้อง ' + r[5] + ' มีนัด ' + r[9] + ' ที่ ' + r[7] + '\n\nถ้าน้องไม่สบาย พิมพ์ "เลื่อนนัด" ได้ค่ะ', C.primary);
  });
}
function sendReminder_Today() {
  eachAppointment_(0, function (r) {
    if (notDone_(r)) pushFlexCard(r[1], '📍 วันนี้มีนัดรับวัคซีน', 'น้อง ' + r[5] + ' มีนัด ' + r[9] + ' ที่ ' + r[7] + '\n\nรับวัคซีนแล้ว กดปุ่ม "มาตามนัดแล้ว" ด้านล่างได้เลยค่ะ', C.deep);
  });
}
function checkStatusAndSideEffects() {
  eachAppointment_(0, function (r) {
    if (!notDone_(r)) return;
    const b = bubble_(header_('สอบถามสถานะ', 'วันนี้น้องได้รับวัคซีนแล้วหรือยัง', C.primary), [
      txt_('น้อง ' + r[5] + ' มีนัด ' + r[9] + ' วันนี้ กดตอบด้านล่างได้เลยค่ะ', {})
    ]);
    const m = flexMsg_('สอบถามสถานะการรับวัคซีน', b);
    m.quickReply = { items: [
      { type: 'action', action: { type: 'message', label: 'มาตามนัดแล้ว', text: 'มาตามนัดแล้ว' } },
      { type: 'action', action: { type: 'message', label: 'ยังไม่ได้มาค่ะ', text: 'ยังไม่ได้มาค่ะ' } }
    ] };
    sendRawPush({ to: r[1], messages: [m] });
  });
}
function sendFollowUp_1DayAfter() {
  eachAppointment_(-1, function (r) {
    if (r[11] !== STATUS_DONE) return;
    pushFlexCard(r[1], '🩺 ติดตามอาการหลังรับวัคซีน', 'น้อง ' + r[5] + ' เป็นอย่างไรบ้างคะหลังรับวัคซีนเมื่อวาน\n\nพิมพ์บอกอาการได้เลย เช่น "ปกติ" "มีไข้" "บวมแดง" ระบบจะให้คำแนะนำทันที', '#5E35B1');
  });
}

function setupTriggers() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (['sendReminder_3DaysBefore', 'sendReminder_1DayBefore', 'sendReminder_Today', 'checkStatusAndSideEffects', 'sendFollowUp_1DayAfter'].indexOf(t.getHandlerFunction()) !== -1) ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('sendReminder_3DaysBefore').timeBased().everyDays(1).atHour(8).inTimezone('Asia/Bangkok').create();
  ScriptApp.newTrigger('sendReminder_1DayBefore').timeBased().everyDays(1).atHour(17).inTimezone('Asia/Bangkok').create();
  ScriptApp.newTrigger('sendReminder_Today').timeBased().everyDays(1).atHour(7).inTimezone('Asia/Bangkok').create();
  ScriptApp.newTrigger('checkStatusAndSideEffects').timeBased().everyDays(1).atHour(15).inTimezone('Asia/Bangkok').create();
  ScriptApp.newTrigger('sendFollowUp_1DayAfter').timeBased().everyDays(1).atHour(10).inTimezone('Asia/Bangkok').create();
}

// สถิติรวมสำหรับแดชบอร์ด (ไม่มีข้อมูลระบุตัวบุคคล)
function buildSummary_() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_MAIN);
  const out = { updated: new Date().toISOString(), total: 0, done: 0, waiting: 0, overdue: 0, byVaccine: {}, byLocation: {} };
  if (!sh) return out;
  const today = new Date(); today.setHours(0, 0, 0, 0);
  sh.getDataRange().getValues().forEach(function (r, i) {
    if (i === 0 || !r[1]) return;
    out.total++;
    const done = r[11] === STATUS_DONE;
    if (done) out.done++; else out.waiting++;
    if (!done && r[10] instanceof Date && r[10] < today) out.overdue++;
    const v = String(r[9] || 'ไม่ระบุ'); out.byVaccine[v] = (out.byVaccine[v] || 0) + 1;
    const l = String(r[7] || 'ไม่ระบุ'); out.byLocation[l] = (out.byLocation[l] || 0) + 1;
  });
  return out;
}

// ==========================================
// 17. ตัวช่วยเรียก LINE API
// ==========================================
function sendCustomFlexPopup(replyToken, title, detail, headerColor) {
  const b = bubble_(header_('FollowUp EPI Ubon', title, headerColor || C.primary), [txt_(detail, {})]);
  reply_(replyToken, [flexMsg_(title, b)]);
}

function pushFlexCard(toUserId, title, detail, headerColor) {
  const b = bubble_(header_('FollowUp EPI Ubon', title, headerColor || C.primary), [txt_(detail, {})]);
  sendRawPush({ to: toUserId, messages: [flexMsg_(title, b)] });
}

function sendRawPush(payload) { callLineAPI(LINE_PUSH_URL, payload); }

function callLineAPI(url, payload) {
  const res = UrlFetchApp.fetch(url, {
    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + getToken_() },
    payload: JSON.stringify(payload)
  });
  const code = res.getResponseCode();
  if (code !== 200) console.error('LINE API ' + code + ': ' + res.getContentText().slice(0, 500));
  return code;
}
