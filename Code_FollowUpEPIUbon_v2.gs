    { type: 'box', layout: 'horizontal', spacing: 'sm', margin: 'lg', contents: [chip_('📅 ตารางวัคซีน', 'ACTION_VIEW_SCHEDULE'), chip_('📚 คลังความรู้', 'ACTION_DISEASE_MENU')] },
    { type: 'box', layout: 'horizontal', spacing: 'sm', margin: 'sm', contents: [chip_('🌡️ มีไข้หลังฉีด', 'SIDE_fever'), chip_('❄️ บวมแดงที่ฉีด', 'SIDE_swelling')] },
