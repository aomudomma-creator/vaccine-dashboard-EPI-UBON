function doGet(e) {
  // ?action=summary คืนสถิติรวม (ไม่มีข้อมูลส่วนบุคคล) สำหรับแดชบอร์ด
  if (e && e.parameter && e.parameter.action === 'summary') {
    return ContentService.createTextOutput(JSON.stringify(buildSummary_()))
      .setMimeType(ContentService.MimeType.JSON);
  }
  return ContentService.createTextOutput('FollowUp EPI Ubon Service Active').setMimeType(ContentService.MimeType.TEXT);
}

function doPost(e) {
  const ok = ContentService.createTextOutput(JSON.stringify({ status: 'ok' })).setMimeType(ContentService.MimeType.JSON);
  if (!e || !e.postData || !e.postData.contents) return ok;
  let json;
  try { json = JSON.parse(e.postData.contents); } catch (err) { return ok; }
  (json.events || []).forEach(function (event) {
    try { handleEvent_(event); } catch (err) { console.error('handleEvent: ' + err + '\n' + (err.stack || '')); }
  });
  return ok;
}

function handleEvent_(event) {
  const replyToken = event.replyToken;
  const userId = event.source && event.source.userId;
  if (event.type === 'follow') { sendWelcome_(replyToken); return; }
  if (event.type === 'postback') { handlePostback_(replyToken, userId, event.postback.data || ''); return; }
  if (event.type === 'message' && event.message.type === 'text') {
    processTextMessage(replyToken, (event.message.text || '').trim(), userId);
  }
}

function handlePostback_(replyToken, userId, data) {
  if (data === 'ACCEPT_PDPA_AND_REGISTER') return handleInternalRegistration(userId, replyToken);
  if (data === 'ACTION_POSTPONE_APPOINTMENT') return sendPostponeInstruction(replyToken);
  if (data === 'ACTION_DELETE_ALL_DATA') return sendDeleteConfirm_(replyToken);
  if (data === 'ACTION_DELETE_CONFIRM') return handleDeleteAllData(userId, replyToken);
  if (data === 'ACTION_VIEW_SCHEDULE_2569' || data === 'ACTION_VIEW_SCHEDULE') return sendSchedulePosterAndDetail(replyToken);
  if (data === 'ACTION_DISEASE_MENU') return sendDiseaseMenuFlex(replyToken);
  if (data === 'ACTION_MAIN_MENU') return sendWelcome_(replyToken);
  if (data.indexOf('DISEASE_DETAIL_') === 0) {
    const parts = data.replace('DISEASE_DETAIL_', '').split('_');
    return sendDiseaseSubDetailFlex(replyToken, parts[0], parts[1]);
  }
  if (data.indexOf('DISEASE_INFO_') === 0) return sendDiseaseSummaryFlex(replyToken, data.replace('DISEASE_INFO_', ''));
  if (data.indexOf('SIDE_') === 0) return sendSideEffectFlex_(replyToken, data.replace('SIDE_', ''));
}

// ==========================================
// 4. จัดเส้นทางข้อความ
// ==========================================
function norm_(s) { return (s || '').toLowerCase().replace(/\s+/g, '').trim(); }

// คำภาษาอังกฤษสั้น ๆ ต้องเป็นคำเดี่ยว (กัน "dt" ไปตรงกับ "dtp", "je" ไปตรงกับคำอื่น)
function hasKw_(clean, kw) {
  const k = norm_(kw);
  if (!k) return false;
  if (/^[a-z0-9\-]+$/.test(k)) {
    return new RegExp('(^|[^a-z])' + k.replace(/[-]/g, '\\-') + '([^a-z]|$)').test(clean);
  }
  return clean.indexOf(k) !== -1;
}

function findDisease_(clean) {
  // ใช้คำที่ยาวที่สุดที่ตรงก่อน เช่น "หัดเยอรมัน" ชนะ "หัด", "ไข้หวัดใหญ่" ชนะคำทั่วไป
  let best = null, bestLen = 0;
  KB.entries.forEach(function (e) {
    e.kw.forEach(function (kw) {
      if (hasKw_(clean, kw) && norm_(kw).length > bestLen) { best = e.key; bestLen = norm_(kw).length; }
    });
  });
  return best;
}

function findSideEffect_(clean) {
  const order = ['seizure', 'rash', 'fever', 'swelling', 'lethargy', 'vomit', 'crying', 'normal'];
  for (let i = 0; i < order.length; i++) {
    const s = KB.side[order[i]];
    for (let j = 0; j < s.kw.length; j++) if (clean.indexOf(norm_(s.kw[j])) !== -1) return order[i];
  }
  return null;
}

function processTextMessage(replyToken, userText, userId) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const clean = norm_(userText);

    // 4.1 เมนูหลักและคำสั่งเฉพาะ
    if (/^(เมนู|menu|help|ช่วยเหลือ|สวัสดี|สวัสดีค่ะ|สวัสดีครับ|เริ่มต้น)$/.test(clean)) return sendWelcome_(replyToken);
    if (userText === 'มาตามนัดแล้ว') return handleArrivalStatus(userId, ss, replyToken);
    if (clean.indexOf('ยังไม่ได้มา') !== -1) return sendNotYetArrivedInstruction(replyToken);
    if (/ตรวจสอบนัด|เช็กนัด|เช็คนัด|ตารางนัดหมาย|นัดของฉัน|checkappointmentschedule/.test(clean)) return handleCheckAppointment(userId, ss, replyToken);
    if (clean === 'ลงทะเบียน' || /self-registration|ลงทะเบียนรับการแจ้งเตือน/.test(clean)) return sendRegistrationFlexMessage(replyToken);
    if (/ยกเลิกการลงทะเบียน|ยกเลิกนัด|แจ้งเลื่อนนัด|เลื่อนนัด|แจ้งยกเลิก|ลบข้อมูล|postponeappointment/.test(clean)) return sendPostponeOrDeleteOptionFlex(replyToken);
    if (/ตารางวัคซีน|กำหนดการวัคซีน|กำหนดการให้วัคซีน|ปี2569|ปี2570|แผนงานสร้างเสริมภูมิคุ้มกันโรค|คู่มือวัคซีน|วัคซีนตามวัย/.test(clean)) return sendSchedulePosterAndDetail(replyToken);
    if (/โรคที่ป้องกันได้ด้วยวัคซีน|ข้อมูลโรค|ความรู้เรื่องโรค|คลังความรู้|ความรู้วัคซีน|วัคซีนทางเลือก/.test(clean)) return sendDiseaseMenuFlex(replyToken);

    // 4.2 อาการหลังฉีด ถ้าพูดถึงเด็กหรือการฉีดชัดเจน ให้ตอบเรื่องอาการก่อน
    const side = findSideEffect_(clean);
    const aboutVaccine = /หลังฉีด|หลังรับวัคซีน|หลังหยอด|ฉีดมา|รับวัคซีนมา|ฉีดเมื่อวาน|หยอดมา/.test(clean);
    const disease = findDisease_(clean);
    if (side && (aboutVaccine || !disease)) return sendSideEffectFlex_(replyToken, side);
    if (disease) return sendDiseaseSummaryFlex(replyToken, disease);

    // 4.3 FAQ จากชีต
    if (handleFAQ(userText, ss, replyToken)) return;

    // 4.4 บันทึกนัดหมายเมื่อพบวันที่
    const extractedDate = extractDateFromText(userText);
    if (extractedDate !== null) {
      const r = saveUserAppointmentInput(userId, userText, extractedDate, ss);
      if (r.success) return r.isMissingParentInfo ? sendIncompleteParentInfoFlex(replyToken, r) : sendAppointmentSaved_(replyToken, r, 'บันทึกนัดหมายเรียบร้อยแล้ว');
    }

    // 4.5 อัปเดตข้อมูลผู้ปกครองที่พิมพ์ตามมา
    const hasPhone = /(0\d{8,9}|0\d{1,2}[\-\s]\d{3,4}[\-\s]\d{3,4})/.test(userText);
    const hasParentKeyword = /(แม่|พ่อ|ผู้ปกครอง|นางสาว|นาง|นาย|ยาย|ย่า|ป้า|น้า|โทร|รับวัคซีนที่|รพสต|รพ\.|โรงพยาบาล)/i.test(userText);
    if (hasPhone || hasParentKeyword) {
      const u = updateParentInfoOnly(userId, userText, ss);
      if (u.success) return u.isMissingParentInfo ? sendIncompleteParentInfoFlex(replyToken, u) : sendAppointmentSaved_(replyToken, u, 'บันทึกข้อมูลครบถ้วนแล้ว');
    }
    // ข้อความอื่น ๆ ปล่อยให้เจ้าหน้าที่ตอบในแชต 1:1 ตามเดิม
  } catch (err) {
    console.error('processTextMessage: ' + err + '\n' + (err.stack || ''));
  }
}

// ==========================================
// 5. ชิ้นส่วน Flex ที่ใช้ซ้ำ
// ==========================================
function txt_(text, o) {
  const t = { type: 'text', text: String(text), wrap: true, size: 'sm', color: C.text };
  return Object.assign(t, o || {});
}
function header_(kicker, title, color) {
  return {
    type: 'box', layout: 'vertical', backgroundColor: color || C.primary, paddingAll: '18px', spacing: 'xs',
    contents: [
      txt_(kicker, { size: 'xxs', color: '#FFFFFFCC', weight: 'bold' }),
      txt_(title, { size: 'lg', color: '#FFFFFF', weight: 'bold' })
    ]
  };
}
function panel_(label, body, bg, color) {
  return {
    type: 'box', layout: 'vertical', backgroundColor: bg || C.bg, cornerRadius: '12px', paddingAll: '12px', spacing: 'xs', margin: 'md',
    contents: [txt_(label, { size: 'xs', weight: 'bold', color: color || C.primary }), txt_(body, { size: 'sm' })]
  };
}
function bullet_(items, color) {
  return items.map(function (s) {
    return {
      type: 'box', layout: 'horizontal', spacing: 'sm', margin: 'sm',
      contents: [txt_('•', { flex: 0, color: color || C.primary, weight: 'bold' }), txt_(s, { flex: 1 })]
    };
  });
}
function btn_(label, data, style, color) {
  return { type: 'button', style: style || 'primary', color: color || C.primary, height: 'sm',
    action: { type: 'postback', label: label.slice(0, 20), data: data } };
}
function msgBtn_(label, text, style, color) {
  return { type: 'button', style: style || 'secondary', color: color, height: 'sm',
    action: { type: 'message', label: label.slice(0, 20), text: text } };
}
function chip_(label, data, color) {
  return {
    type: 'box', layout: 'vertical', flex: 1, backgroundColor: C.tint, cornerRadius: '10px', paddingAll: '10px',
    action: { type: 'postback', label: label.slice(0, 20), data: data },
    contents: [txt_(label, { size: 'xs', weight: 'bold', color: color || C.deep, align: 'center' })]
  };
}
function contactBox_() {
  return panel_('📞 ช่องทางติดต่อ', CONTACT_TEXT, '#FFF6EC', C.warn);
}
function bubble_(header, bodyContents, footerContents) {
  const b = { type: 'bubble', size: 'mega', header: header,
    body: { type: 'box', layout: 'vertical', paddingAll: '16px', contents: bodyContents } };
  if (footerContents && footerContents.length) b.footer = { type: 'box', layout: 'vertical', spacing: 'sm', paddingAll: '12px', contents: footerContents };
  return b;
}
function quickMenu_() {
  const items = [
    ['📅 ตารางวัคซีน', 'ตารางวัคซีน'], ['📚 คลังความรู้', 'คลังความรู้'], ['🗓️ เช็กนัด', 'เช็กนัด'],
    ['📝 ลงทะเบียน', 'ลงทะเบียน'], ['🫧 วัคซีน PCV', 'PCV'], ['🌡️ ไข้หวัดใหญ่', 'ไข้หวัดใหญ่'], ['🌸 HPV', 'HPV']
  ];
  return { items: items.map(function (i) { return { type: 'action', action: { type: 'message', label: i[0], text: i[1] } }; }) };
}
function reply_(replyToken, messages) {
  messages[messages.length - 1].quickReply = messages[messages.length - 1].quickReply || quickMenu_();
  callLineAPI(LINE_REPLY_URL, { replyToken: replyToken, messages: messages });
}
function flexMsg_(alt, contents) { return { type: 'flex', altText: String(alt).slice(0, 380), contents: contents }; }

