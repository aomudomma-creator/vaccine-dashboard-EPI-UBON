function sendDiseaseMenuFlex(replyToken) {
  const groups = {};
  KB.entries.forEach(function (e) { (groups[e.group] = groups[e.group] || []).push(e); });
  const bubbles = [];
  Object.keys(groups).forEach(function (g) {
    const list = groups[g];
    for (let i = 0; i < list.length; i += 7) {
      const part = list.slice(i, i + 7);
      const rows = part.map(function (e) {
        return {
          type: 'box', layout: 'horizontal', spacing: 'md', paddingAll: '10px', cornerRadius: '10px', backgroundColor: C.bg, margin: 'sm',
          action: { type: 'postback', label: e.short.slice(0, 20), data: 'DISEASE_INFO_' + e.key },
          contents: [
            txt_(e.icon, { flex: 0, size: 'md' }),
            txt_(e.short, { flex: 1, weight: 'bold', color: C.deep, gravity: 'center' }),
            txt_('›', { flex: 0, color: C.primary, size: 'lg', gravity: 'center' })
          ]
        };
      });
      const title = g + (list.length > 7 ? ' (' + (i / 7 + 1) + ')' : '');
      bubbles.push(bubble_(header_('คลังความรู้วัคซีน', title, g.indexOf('ทางเลือก') !== -1 ? '#5E35B1' : (g.indexOf('ฤดูกาล') !== -1 ? '#00897B' : C.primary)), rows));
    }
  });
  bubbles.push(bubble_(header_('ตารางวัคซีน', 'กำหนดการตามวัย', C.deep), [
    txt_('ดูวัคซีนที่เด็กไทยได้รับฟรีในแต่ละช่วงวัย รวมวัคซีน PCV ที่เริ่มฉีด 2 พ.ย. 2569', {}),
  ], [btn_('📅 เปิดตารางวัคซีน', 'ACTION_VIEW_SCHEDULE', 'primary', C.deep)]));
  reply_(replyToken, [flexMsg_('คลังความรู้โรคและวัคซีน', { type: 'carousel', contents: bubbles.slice(0, 12) })]);
}

function sendDiseaseSummaryFlex(replyToken, key) {
  const e = KB_INDEX[key];
  if (!e) return;
  const chips = [];
  for (let i = 0; i < SECTIONS.length; i += 2) {
    const row = [chip_(SECTIONS[i].label, 'DISEASE_DETAIL_' + key + '_' + SECTIONS[i].key, e.color)];
    if (SECTIONS[i + 1]) row.push(chip_(SECTIONS[i + 1].label, 'DISEASE_DETAIL_' + key + '_' + SECTIONS[i + 1].key, e.color));
    chips.push({ type: 'box', layout: 'horizontal', spacing: 'sm', contents: row });
  }
  const b = bubble_(header_(e.icon + '  ' + e.group, e.name, e.color), [
    txt_(e.summary),
    panel_('💉 กำหนดการให้วัคซีน', e.vaccine, C.tint, e.color),
    panel_('👥 กลุ่มเป้าหมาย / สิทธิ', e.who, C.bg, C.deep),
    txt_('เลือกหัวข้อที่อยากรู้เพิ่ม 👇', { size: 'xs', color: C.muted, margin: 'lg' })
  ], chips.concat([btn_('📚 กลับคลังความรู้', 'ACTION_DISEASE_MENU', 'link', C.primary)]));
  reply_(replyToken, [flexMsg_(e.name + ' — สรุปสั้น', b)]);
}

function sendDiseaseSubDetailFlex(replyToken, key, section) {
  const e = KB_INDEX[key];
  if (!e) return;
  const sec = SECTIONS.filter(function (s) { return s.key === section; })[0] || SECTIONS[0];
  const body = [];
  if (sec.key === 'cause') {
    body.push(panel_('เชื้อก่อโรค', e.cause, C.bg, e.color));
    body.push(panel_('การติดต่อ', e.spread, C.bg, e.color));
  } else if (sec.key === 'evidence') {
    body.push(txt_(e.evidence));
    body.push({ type: 'separator', margin: 'lg', color: C.line });
    body.push(txt_('แหล่งอ้างอิง', { size: 'xs', weight: 'bold', color: C.primary, margin: 'md' }));
    e.refs.forEach(function (r, i) { body.push(txt_((i + 1) + ') ' + KB.refs[r], { size: 'xxs', color: C.muted, margin: 'sm' })); });
  } else {
    body.push(txt_(e[sec.key] || 'ยังไม่มีข้อมูลในหัวข้อนี้'));
  }
  if (sec.key === 'side' || sec.key === 'symptoms') body.push(contactBox_());
  if (sec.key === 'situation') body.push(txt_('ที่มา: ' + KB.refs[e.refs[0]], { size: 'xxs', color: C.muted, margin: 'lg' }));
  const b = bubble_(header_(e.icon + '  ' + e.name, sec.title, e.color), body, [
    btn_('↩︎ กลับหน้าสรุป', 'DISEASE_INFO_' + key, 'secondary'),
  ]);
  reply_(replyToken, [flexMsg_(e.name + ' — ' + sec.title, b)]);
}

